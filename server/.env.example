# ===================================================
# CRINGE METER — Backend Environment Configuration
# ===================================================

PORT=3000

# 1. Supabase PostgreSQL Cloud Database (Required for persistent cloud storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. LiveKit WebRTC Cloud (1v1 Video & Audio Stream)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# 3. Resend / Email Provider (Promotional & Tournament Broadcasts)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CRINGE METER <tournament@cringemeter.io>
APP_PUBLIC_URL=https://cringe-meter.onrender.com
